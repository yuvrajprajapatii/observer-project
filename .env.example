# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB connection string
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/observer?retryWrites=true&w=majority"

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-minimum-32-characters-long"

# Application URL
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# OAUTH PROVIDERS
# ============================================

# Google OAuth
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# ============================================
# EXTERNAL APIS
# ============================================

# Hugging Face API
HUGGINGFACE_API_KEY="hf_your-huggingface-api-key-here"

# OpenAI API
OPENAI_API_KEY="sk-your-openai-api-key-here"

# YouTube Data API
YOUTUBE_API_KEY="your-youtube-data-api-key"

# ============================================
# DEVELOPMENT
# ============================================

# Node environment
NODE_ENV="development"

# Debug logging
DEBUG="nextauth:*"